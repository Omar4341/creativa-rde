# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Supabase — BACKEND ONLY (never expose to frontend) ───────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Supabase — Safe for Presenter Realtime subscription (frontend-visible) ───
SUPABASE_ANON_KEY=your-anon-key

# ─── QR Token Signing ─────────────────────────────────────────────────────────
# Minimum 32 characters — app will refuse to start if shorter
QR_JWT_SECRET=your-minimum-32-character-random-secret-here
QR_TOKEN_EXPIRY_HOURS=24

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Never use '*'.
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10
