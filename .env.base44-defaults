# Development placeholders — enough to boot the app before real credentials are provided.
# Real secrets in /run/base44/app.env (delivered by the platform) override these values.

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Supabase — BACKEND ONLY (never expose to frontend) ───────────────────────
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-development-service-role-key

# ─── Supabase — Safe for Presenter Realtime subscription (frontend-visible) ───
SUPABASE_ANON_KEY=placeholder-development-anon-key

# ─── QR Token Signing ─────────────────────────────────────────────────────────
QR_JWT_SECRET=placeholder-development-qr-jwt-secret-at-least-32-chars-long
QR_TOKEN_EXPIRY_HOURS=24

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10
