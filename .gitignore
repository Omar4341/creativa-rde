!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# TypeScript incremental compilation
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Coverage
coverage/

# Supabase CLI local state may include database connection details
/supabase/.temp/
